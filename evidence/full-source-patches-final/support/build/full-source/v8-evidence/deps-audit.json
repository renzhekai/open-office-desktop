        "--disable"
      ],
      "condition": null,
      "status": "not_executed"
    },
    {
      "name": "landmines",
      "action": [
        "python",
        "build/landmines.py",
        "--landmine-scripts",
        "tools/get_landmines.py"
      ],
      "condition": null,
      "status": "not_executed"
    },
    {
      "name": "clang_format_win",
      "action": [
        "download_from_google_storage",
        "--no_resume",
        "--platform=win32",
        "--no_auth",
        "--bucket",
        "chromium-clang-format",
        "-s",
        "buildtools/win/clang-format.exe.sha1"
      ],
      "condition": "host_os == \"win\"",
      "status": "not_executed"
    },
    {
      "name": "clang_format_mac",
