        "tools/clang/scripts/update.py"
      ],
      "condition": "host_os != \"aix\"",
      "status": "not_executed"
    },
    {
      "name": "clang_tidy",
      "action": [
        "python",
        "tools/clang/scripts/update.py",
        "--package=clang-tidy"
      ],
      "condition": "checkout_clang_tidy",
      "status": "not_executed"
    },
    {
      "name": "lastchange",
      "action": [
        "python",
        "build/util/lastchange.py",
        "-o",
        "build/util/LASTCHANGE"
      ],
      "condition": null,
      "status": "not_executed"
    },
    {
      "name": "Download Fuchsia SDK",
      "action": [
        "python",
        "build/fuchsia/update_sdk.py"
      ],
      "condition": "checkout_fuchsia",
      "status": "not_executed"
    },
    {
      "name": "Download Fuchsia system images",
      "action": [
        "python",
        "build/fuchsia/update_images.py",
        "--boot-images={checkout_fuchsia_boot_images}"
      ],
      "condition": "checkout_fuchsia",
      "status": "not_executed"
    },
    {
      "name": "lld/mac",
      "action": [
        "python",
        "tools/clang/scripts/update.py",
        "--package=lld_mac"
      ],
      "condition": "host_os == \"mac\" and checkout_fuchsia",
      "status": "not_executed"
    },
    {
      "name": "llvm-objdump",
      "action": [
        "python",
        "tools/clang/scripts/update.py",
        "--package=objdump"
      ],
      "condition": "host_os == \"mac\" and checkout_fuchsia",
      "status": "not_executed"
    },
    {
      "name": "vpython_common",
      "action": [
        "vpython",
        "-vpython-spec",
        ".vpython",
        "-vpython-tool",
        "install"
      ],
      "condition": "checkout_android",
      "status": "not_executed"
    },
    {
      "name": "check_v8_header_includes",
      "action": [
        "python",
        "tools/generate-header-include-checks.py"
      ],
      "condition": "check_v8_header_includes",
      "status": "not_executed"
    }
  ],
  "strategy": "Explicit pinned Git sources, no hooks/bootstrap; GN is the only DEPS CIPD binary needed for this target."
}
