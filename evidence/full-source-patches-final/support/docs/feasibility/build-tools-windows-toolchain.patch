@@ -3,6 +3,28 @@
 import base
 import os
 import platform
+import re
+
+def configure_windows_toolchain():
+  # Explicit, process-local overrides; do not change global machine settings.
+  vcvars_ver = option("vcvars-ver")
+  if vcvars_ver:
+    if not re.match(r"^14\.[0-9]+\.[0-9]+\Z", vcvars_ver):
+      raise ValueError("vcvars-ver must be a complete MSVC tools version, e.g. 14.44.35207")
+    if not option("vs-path") or not os.path.isfile(os.path.join(option("vs-path"), "vcvarsall.bat")):
+      raise ValueError("vcvars-ver requires vs-path containing vcvarsall.bat")
+
+  cmake_dir = option("cmake-dir")
+  if cmake_dir:
+    cmake_dir = os.path.abspath(cmake_dir)
+    if not os.path.isfile(os.path.join(cmake_dir, "cmake.exe")):
+      raise ValueError("cmake-dir must contain cmake.exe: " + cmake_dir)
+    # Repeated parse calls must not repeatedly prepend the same directory.
+    path = os.environ.get("PATH", "").split(os.pathsep)
+    path = [entry for entry in path if os.path.normcase(entry) != os.path.normcase(cmake_dir)]
+    os.environ["PATH"] = os.pathsep.join([cmake_dir] + path)
+    options["cmake-dir"] = cmake_dir
+    os.environ["OO_CMAKE_DIR"] = cmake_dir
 
