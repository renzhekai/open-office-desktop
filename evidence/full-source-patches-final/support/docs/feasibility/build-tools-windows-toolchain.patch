diff --git a/scripts/qmake.py b/scripts/qmake.py
index 921934e..d031796 100644
--- a/scripts/qmake.py
+++ b/scripts/qmake.py
@@ -10,6 +10,67 @@ import base
 import config
 import android_ndk
 import multiprocessing
+import re
+
+def windows_quote(value):
+  # Batch files expand percent signs even inside quotes. Reject unsupported
+  # values instead of silently changing a path or treating it as shell code.
+  if any(char in value for char in ['"', '%', '\r', '\n', '\x00']):
+    raise ValueError("Unsupported character in Windows build argument: " + repr(value))
+  # Windows native argv parsing treats backslashes immediately before the
+  # closing quote specially, so double any trailing backslashes.
+  trailing = len(value) - len(value.rstrip("\\"))
+  return '"' + value + ('\\' * trailing) + '"'
+
+def windows_command(program, arguments):
+  command = " ".join(windows_quote(value) for value in [program] + arguments)
+  if program.lower().endswith((".bat", ".cmd")):
+    # CALL reparses its arguments. Keep batch paths/arguments free of expansion
+    # and shell metacharacters; executable paths still support & and parentheses.
+    if any(char in value for value in [program] + arguments for char in "!^&|<>"):
+      raise ValueError("Unsupported character in called batch argument")
+    command = "call " + command
+  return command
+
+def windows_build_commands(platform, qmake_app, file_pro, makefile,
+                           config_params, qmake_addon, jom_exe, qmake_env_addon=""):
+  """Generate commands only: no subprocess, download, or filesystem mutation."""
+  arch = "x86" if base.platform_is_32(platform) else "x64"
+  if platform == "win_arm64":
+    arch = "x64_arm64"
+  vcvars_args = [arch]
+  vcvars_ver = config.option("vcvars-ver")
+  if vcvars_ver:
+    if not re.match(r"^14\.[0-9]+\.[0-9]+\Z", vcvars_ver):
+      raise ValueError("vcvars-ver must be a complete MSVC tools version")
+    vcvars_args.append("-vcvars_ver=" + vcvars_ver)
+  commands = ["@echo off", "setlocal DisableDelayedExpansion"]
+  commands.append(windows_command(config.option("vs-path") + "/vcvarsall.bat", vcvars_args))
+  commands.append('if not "%errorlevel%"=="0" exit /b %errorlevel%')
+  if vcvars_ver:
+    commands.append('if not "%VCToolsVersion%"=="' + vcvars_ver + '" exit /b 1')
+
+  cmake_dir = config.option("cmake-dir")
+  if cmake_dir:
+    windows_quote(cmake_dir)  # Validate before embedding in a SET command.
+    commands.append('set "PATH=' + cmake_dir + ';%PATH%"')
+
+  # qt_setup currently supplies either an empty value or '-spec <name>'.
+  qmake_args = ["-nocache"] + qmake_env_addon.split() + [file_pro] + config_params + qmake_addon
+  qmake_command = windows_command(qmake_app, qmake_args)
+  commands.extend([qmake_command, 'if not "%errorlevel%"=="0" exit /b %errorlevel%'])
+  make_exe = jom_exe if jom_exe else "nmake.exe"
+  if "1" == config.option("clean"):
+    # Preserve upstream's best-effort clean, but never hide qmake/build failure.
+    commands.append(windows_command(make_exe, ["clean", "-f", makefile]))
+    commands.append(windows_command(make_exe, ["distclean", "-f", makefile]))
+    commands.extend([qmake_command, 'if not "%errorlevel%"=="0" exit /b %errorlevel%'])
+  if not jom_exe and "0" != config.option("multiprocess"):
+    commands.append("set CL=/MP")
+  make_args = ["-f", makefile] + (get_j_num() if jom_exe else [])
+  commands.append(windows_command(make_exe, make_args))
+  commands.append("exit /b %errorlevel%")
+  return commands
 
