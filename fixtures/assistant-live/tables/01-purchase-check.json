{
  "name": "采购清单：点进表格说“检查一下，有错直接改”（错别字、金额算错）",
  "document": "fixtures/assistant-samples/purchase-list.docx",
  "steps": [
    {
      "check": "snapshot",
      "table": 1
    },
    {
      "tool": "selection.select",
      "args": {
        "table": 1,
        "row": 2,
        "column": 2
      },
      "expect": {
        "ok": true
      }
    },
    {
      "tool": "test.ask",
      "args": {
        "text": "帮我检查一下这个表格，有错的地方直接改"
      },
      "expect": {
        "ok": true,
        "buttonsInclude": [
          "全部改正"
        ]
      }
    },
    {
      "tool": "test.press",
      "args": {
        "button": "全部改正"
      },
      "expect": {
        "ok": true
      }
    },
    {
      "check": "cell",
      "table": 1,
      "row": 2,
      "column": 2,
      "equals": "笔记本"
    },
    {
      "check": "cell",
      "table": 1,
      "row": 3,
      "column": 5,
      "matches": "60(\\.0+)?"
    },
    {
      "check": "unchangedExcept",
      "table": 1,
      "cells": [
        "R2C2",
        "R3C5",
        "R2C3",
        "R3C3",
        "R4C3",
        "R5C3",
        "R6C3",
        "R2C5",
        "R3C5",
        "R4C5",
        "R5C5",
        "R6C5"
      ],
      "someChanged": true
    }
  ]
}
