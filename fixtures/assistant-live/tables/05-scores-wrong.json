{
  "name": "成绩表：点进表格问“总分有没有算错”（一处错）",
  "document": "fixtures/assistant-samples/scores.docx",
  "steps": [
    {
      "check": "snapshot",
      "table": 1
    },
    {
      "tool": "selection.select",
      "args": {
        "table": 1,
        "row": 3,
        "column": 1
      },
      "expect": {
        "ok": true
      }
    },
    {
      "tool": "test.ask",
      "args": {
        "text": "看看总分有没有算错"
      },
      "expect": {
        "ok": true,
        "buttonsInclude": [
          "全部改正"
        ]
      }
    },
    {
      "tool": "test.press",
      "args": {
        "button": "全部改正"
      },
      "expect": {
        "ok": true
      }
    },
    {
      "check": "cell",
      "table": 1,
      "row": 2,
      "column": 5,
      "equals": "265"
    },
    {
      "check": "unchangedExcept",
      "table": 1,
      "cells": [
        "R2C5"
      ],
      "someChanged": true
    }
  ]
}
